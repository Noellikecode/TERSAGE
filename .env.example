# FIRST DUE environment. Copy to .env and edit.
#
# NEVER put a secret value in this file or in .env. Secrets come from the
# environment or Secret Manager. `.env` is gitignored; this example is not.

# ---------------------------------------------------------------- mode ------
# true  -> credential-free fake mode. The whole fleet runs with no Google auth.
# false -> live mode. Every GCP_* value below becomes required at startup.
USE_FAKE_AGENTS=true

# --------------------------------------------------------- durable memory ---
# Where profiles, facts, locks, and idempotency records live.
#   memory    -> in-process. Lost on restart. The default, and what `make demo` uses.
#   firestore -> a real Firestore, reached through Application Default
#                Credentials. There is no emulator; run
#                `gcloud auth application-default login` and set GCP_PROJECT_ID.
STORAGE_BACKEND=memory

# How events move between agents.
#   memory -> in-process bus. Same delivery policy as Pub/Sub, no broker.
#   pubsub -> publishes to Pub/Sub; delivery arrives at the internal push endpoint.
EVENT_BACKEND=memory

# Whether the survey calendar and crew mail reach Google Workspace for real.
#   fake   -> record both locally, audited and idempotent exactly as live. The
#             console labels them simulated. THE DEFAULT.
#   google -> call Calendar and Gmail. Requires delegated user authority:
#             domain-wide delegation on a Workspace domain, or an interactive
#             OAuth consent. Application Default Credentials alone are NOT
#             enough -- a service account has no calendar and no mailbox.
# Separate from USE_FAKE_AGENTS on purpose: these are the only two write
# targets in the fleet that act as a *user* rather than as the deployment.
WORKSPACE_WRITES=fake

# ----------------------------------------------------------------- app ------
APP_ENV=local                 # local | test | staging | production
# Which surfaces this process serves. Cloud Run sets it per service.
#   all      -> everything. The default, and what the demo runs.
#   slow     -> the slow loop: district polls, the queue, profiles, referrals.
#   incident -> the incident loop: dispatch, briefs, streams, resources.
FIRSTDUE_LOOP=all
# Set on an agent worker to the one agent it runs. Empty means the whole fleet.
# A worker refuses work addressed to any other agent, because it holds only
# that agent's service account.
FIRSTDUE_AGENT=
PORT=8000                     # Cloud Run overrides this; never hard-code 8080
LOG_LEVEL=INFO
LOG_JSON=true
SHUTDOWN_GRACE_SECONDS=10

# -------------------------------------------------------- municipality ------
MUNICIPALITY_ID=san-francisco-ca
DEFAULT_DISTRICT_ID=sffd-district-03
FIXTURES_DIR=fixtures

# --------------------------------------------------------- determinism ------
# Same seed + same epoch => byte-identical demo state on every reset.
DEMO_SEED=firstdue-demo
DEMO_EPOCH=2026-08-20T08:00:00+00:00
DEMO_STATE_DIR=.demo-state

# ------------------------------------------------------------ google --------
# Required only when USE_FAKE_AGENTS=false. No values committed here.
GCP_PROJECT_ID=
GCP_REGION=us-west1
FIRESTORE_DATABASE=(default)
PUBSUB_TOPIC_PREFIX=firstdue
GCS_PLANS_BUCKET=
VERTEX_LOCATION=us-central1
GEMINI_MODEL=gemini-3.5-flash
GEMMA_MODEL=gemma-3-4b-it
VECTOR_SEARCH_INDEX=
MODEL_ARMOR_TEMPLATE=

# ------------------------------------------------- live source access -------
# Needed only in live mode, and only for the two sources that require a key.
# A source whose key is absent reports UNCONFIGURED. It never falls back to a
# fixture: a live-mode process serving synthetic records would be lying about
# where its data came from.
#
# Google Maps Platform key with the Solar API enabled. Without it the roof
# geometry is unavailable -- and with USGS 3DEP it is what measures a
# building's height, which is what disagrees with the permit.
GOOGLE_MAPS_API_KEY=
# developer.nrel.gov key for the EV charger registry. Free, self-service.
NREL_API_KEY=
# DataSF app token. Optional: it identifies the caller to lift the anonymous
# rate limit. It authorizes nothing, and every DataSF feed is public without it.
SOCRATA_APP_TOKEN=
# The National Weather Service asks every caller to identify itself and
# throttles those that do not.
SOURCE_CONTACT_EMAIL=firstdue@example.org
# Prefixes every Firestore collection. Empty in production; the contract suite
# sets a unique value per run so parallel runs cannot collide, and so a run can
# delete exactly what it wrote.
FIRESTORE_NAMESPACE=

# ------------------------------------------------------- contract testing ---
# The throwaway project the contract suite runs against, separate from the one
# the app uses. `make test-cloud GCP_TEST_PROJECT_ID=...` sets these for you.
# Requires `gcloud auth application-default login` first.
# FIRESTORE_TEST_PROJECT=
# PUBSUB_TEST_PROJECT=
# FIRESTORE_TEST_DATABASE=

# -------------------------------------------------------- event delivery ---
EVENT_MAX_ATTEMPTS=5          # attempts per consumer before a dead letter
EVENT_BASE_DELAY_MS=250       # first backoff; doubles from there
EVENT_MAX_DELAY_MS=60000
EVENT_JITTER_RATIO=0.25       # derived from the event id, never random
BREAKER_FAILURE_THRESHOLD=3   # transient failures before a consumer is cut off
BREAKER_COOLDOWN_SECONDS=30
LOCK_LEASE_SECONDS=300        # how long a district poll holds its lock

# ----------------------------------------------- internal push endpoint -----
# The endpoint Pub/Sub pushes events to. It authenticates, and refuses every
# request if it cannot -- there is no unauthenticated path into the event stream.
#
# FAKE MODE: leave INTERNAL_PUSH_TOKEN empty. A token is derived from DEMO_SEED
# at startup and printed by `firstdue status`. No secret is stored in any file.
INTERNAL_PUSH_TOKEN=
# LIVE MODE: the endpoint verifies a Google-issued OIDC token instead. Both of
# these become required when EVENT_BACKEND=pubsub and USE_FAKE_AGENTS=false.
INTERNAL_PUSH_AUDIENCE=
INTERNAL_PUSH_SERVICE_ACCOUNT=

# ---------------------------------------------------------------- api ------
CORS_ALLOW_ORIGINS=["http://localhost:3000"]
INSTANT_BRIEF_BUDGET_MS=500

# ------------------------------------------------------------ frontend ------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
