# FIRST DUE console.
#
# NEVER put a secret value here. `.env.local` is gitignored; this example is not.

# Where the backend is, read by the server at RUNTIME. This is the one Cloud Run
# sets (`FIRSTDUE_API_BASE_URL` on the console service). Prefer it everywhere
# server-side.
FIRSTDUE_API_BASE_URL=http://localhost:8000

# The same value for local development only. Next.js inlines `NEXT_PUBLIC_*` at
# BUILD time, so this is empty inside the Docker image and cannot be used to
# point a deployed console at its backend. Kept as the local fallback because
# `make demo` sets it.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# The console's backend credential. Deliberately NOT a NEXT_PUBLIC_ variable:
# Next.js inlines those into the client bundle, and a token in the browser is a
# token in anyone's devtools.
#
# In fake mode this is derived from DEMO_SEED and printed by `firstdue status`,
# so the demo authenticates without a secret existing in any file.
FIRSTDUE_CONSOLE_TOKEN=

# Live mode only. When set, the gateway route stops using the static token above
# and mints a Google-issued OIDC identity token from the Cloud Run metadata
# server for this audience, caching it until shortly before it expires. The
# backend verifies that token; it does not accept a shared secret in live mode.
#
# Leave EMPTY locally: an empty audience is what selects the static-token path
# that `make demo` depends on.
FIRSTDUE_API_AUDIENCE=

# The browser's Maps key, for Google's Photorealistic 3D Tiles.
#
# The one deliberate exception to the rule above. Tiles stream directly from
# `tile.googleapis.com` as the camera moves, so this key cannot stay server-side
# the way the backend token does -- it is inlined into the client bundle and is
# public by construction.
#
# Because of that it MUST be a SEPARATE key from the backend's, restricted by
# HTTP referrer in the Cloud console and scoped to the Map Tiles API alone. An
# unrestricted browser key is billable by anyone who reads the page source.
#
# Unset, the structure panel says the photorealistic view is UNCONFIGURED and
# the massing model still draws.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
